# Copy to .env.local, or run `pnpm setup:env` to generate one with fresh local secrets.
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
DATABASE_URL=postgresql://inlet:inlet@localhost:5433/inlet
REDIS_URL=redis://localhost:6380

# Generated locally. Never commit real values.
SESSION_SECRET=
MASTER_ENCRYPTION_KEY=
FIXTURE_CONTROL_TOKEN=
EGRESS_CONTROL_TOKEN=
DEPLOY_WEBHOOK_SECRET=

ARTIFACT_STORE_PATH=./.local-artifacts

MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_API_URL=http://localhost:8025

# Controlled test sites. Host-facing ports are published on 127.0.0.1 only.
FIXTURE_SITE_URL=http://localhost:3110
FIXTURE_BROKEN_SITE_URL=http://localhost:3111
FIXTURE_DEMO_BROKEN_SITE_URL=http://localhost:3112
FIXTURE_ATTACK_SITE_URL=http://localhost:3113
FIXTURE_CONTROL_URL=http://localhost:3190

SANDBOX_BACKEND=local-oci
SANDBOX_OCI_RUNTIME=runc
SANDBOX_EGRESS_PROFILE=fixture-only
EGRESS_CONTROL_URL=http://localhost:3191
EGRESS_PROXY_HOST=172.30.0.2
EGRESS_PROXY_PORT=3128
SANDBOX_NETWORK=inlet-sandbox
SANDBOX_BROWSER_IMAGE=inlet-runner-browser:local
SANDBOX_REPAIR_IMAGE=inlet-runner-repair:local
SANDBOX_SINK_IMAGE=axllent/mailpit:v1.27

# Phase B. The non-AI flows work without these.
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_MODEL=
VULTR_VISION_MODEL=

# Phase C. Optional. Patch export works without GitHub.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_URL=https://api.github.com

# Outbound product email (password resets, invitations, alerts). Mailpit locally.
NOTIFY_SMTP_HOST=127.0.0.1
NOTIFY_SMTP_PORT=1025
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASSWORD=
NOTIFY_FROM='Inlet <alerts@inlet.test>'

DEMO_PUBLIC_MODE=false
AUDIT_RETENTION_DAYS=30
OBSERVATION_WINDOW_SECONDS=30
WORKER_CONCURRENCY=2
LOG_LEVEL=info

# Host ports for local infrastructure.
INLET_POSTGRES_PORT=5433
INLET_REDIS_PORT=6380
