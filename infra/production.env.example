# Copy to infra/production.env on the server. Never commit the copy.
# Generate each secret with: openssl rand -hex 32
# MASTER_ENCRYPTION_KEY must be: openssl rand -base64 32
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://inlet.example.com

SESSION_SECRET=
MASTER_ENCRYPTION_KEY=
FIXTURE_CONTROL_TOKEN=
EGRESS_CONTROL_TOKEN=
DEPLOY_WEBHOOK_SECRET=

ARTIFACT_STORE_PATH=/data/artifacts

# gVisor on the Vultr VM. Run infra/scripts/verify-sandbox.sh before relying on it.
SANDBOX_BACKEND=vultr-gvisor
SANDBOX_EGRESS_PROFILE=verified-public
DEMO_PUBLIC_MODE=true

VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_MODEL=deepseek-v4.1-flash-1017

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Outbound product email. Point at a real SMTP provider for real recipients.
NOTIFY_SMTP_HOST=mailpit
NOTIFY_SMTP_PORT=1025
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASSWORD=
NOTIFY_FROM='Inlet <alerts@inlet.example.com>'

LOG_LEVEL=info
