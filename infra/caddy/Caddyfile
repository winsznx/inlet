{
	email {$ACME_EMAIL}
	admin 127.0.0.1:2019
}

{$INLET_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Run events are server-sent, so this route must not buffer or compress.
	handle /api/v1/* {
		reverse_proxy api:4000 {
			flush_interval -1
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy web:3000
	}
}
