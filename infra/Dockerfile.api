FROM node:24-bookworm-slim AS build
RUN npm install -g --no-audit --no-fund pnpm@12.16.1
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml .npmrc package.json ./
RUN pnpm fetch
COPY . .
RUN pnpm install --offline --frozen-lockfile --filter "@inlet/api..."
RUN pnpm --filter @inlet/api build

FROM node:24-bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git tar \
  && rm -rf /var/lib/apt/lists/*
# /health/ready shells out to the docker CLI. In production the API talks to a
# read-only socket proxy, never to the engine socket itself.
COPY --from=docker:29.0.4-cli /usr/local/bin/docker /usr/local/bin/docker
WORKDIR /app
COPY --from=build /app/package.json /app/pnpm-workspace.yaml ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/apps/api ./apps/api
COPY infra/scripts/ops-status.ts infra/scripts/ops-status.ts
RUN mkdir -p /data/artifacts && chown node:node /data/artifacts
ENV NODE_ENV=production INLET_SKIP_ENV_FILE=1 ARTIFACT_STORE_PATH=/data/artifacts DOCKER_CONFIG=/tmp/.docker
USER node
WORKDIR /app/apps/api
EXPOSE 4000
# The esbuild output keeps every package external, and the @inlet/* packages
# export TypeScript with extensionless relative imports, which plain Node
# cannot resolve. The tsx loader can.
CMD ["node", "--import", "tsx", "dist/main.mjs"]
